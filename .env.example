# Presence Scanner Configuration -- copy to `.envrc` (direnv) or `.env` and
# fill in your own real values. NEVER commit a file with real secrets.
#
# config.py is the source of truth: it reads every one of these at startup.
# Nothing here has a real default baked into source control.

# Zyxel router API (remote, over the WAN IP or LAN)
export ZYXEL_URL="https://192.168.1.1"
export ZYXEL_USER="admin"
export ZYXEL_PASS="change-me"

# Philips Hue bridge (optional). Leaving HUE_USERNAME unset (the default)
# automatically selects a deterministic MOCK backend, so the light-based
# enhanced status (Downstairs/Around/Awake/Sleeping/Away) works out of the
# box with no real smart-home hardware. Set HUE_USERNAME for a real bridge,
# or set HUE_BACKEND explicitly ("live" or "mock") to override the default.
export HUE_BACKEND=""
export HUE_BASE_URL="http://192.168.1.2:80"
export HUE_USERNAME=""
export HUE_LIVING_ROOM_GROUP="1"
export HUE_SECONDARY_ROOM_GROUP="2"
# Which device key (from DEVICES below) gets light-based enhanced status.
# Defaults to "example" (the placeholder device); set to "" to disable.
export HUE_ENHANCED_DEVICE_ID="example"
# Mock backend only: pin the simulated hour (0-23) for reproducible demos.
export HUE_MOCK_FORCE_HOUR=""

# Devices to track (MAC is the source of truth for presence).
# Only include devices you have explicit permission to monitor.
export DEVICES='{
  "example": {"name": "Example Device", "ip": "192.168.1.100", "mac": "aa:bb:cc:dd:ee:ff"}
}'

# Data directory
export DATA_DIR="/var/lib/presence-scanner"

# Scan tuning (optional -- these already have safe defaults in config.py)
export SCAN_INTERVAL="60"
export DEBOUNCE_DELAY="5"

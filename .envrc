# Presence Scanner Configuration (reference only)
#
# NOTE: config.py is the source of truth. These exports document the deployment
# and are handy for ad-hoc curl testing; they are not read by the app.
#
# The host is remote (not on the LAN). Everything is reached via the router's
# WAN IP: the Zyxel API over HTTPS, and the Hue bridge on a forwarded port.

# Zyxel router API (remote)
export ZYXEL_URL="https://203.0.113.1"
export ZYXEL_USER="admin"
export ZYXEL_PASS="ZYXEL_PASSWORD_REDACTED"

# Hue bridge -- LAN 192.168.1.103, exposed on the router at WAN port 25875
export HUE_BASE_URL="http://203.0.113.1:25875"
export HUE_USERNAME="HUE_USERNAME_REDACTED"
export HUE_LIVING_ROOM_GROUP="81"
export HUE_VALOU_ROOM_GROUP="84"

# Devices (MAC is the source of truth for presence)
export DEVICES='{
  "alex": {"name": "Alex", "ip": "192.168.1.101", "mac": "aa:bb:cc:dd:ee:01"},
  "roomie": {"name": "Roomie", "ip": "192.168.1.102", "mac": "aa:bb:cc:dd:ee:02"}
}'

# Data directory
export DATA_DIR="/var/lib/presence-scanner"

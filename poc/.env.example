# POC suite environment
#
# Live POCs (A–E) source their values from the REPO-ROOT .envrc (direnv):
#   ZYXEL_URL / ZYXEL_USER / ZYXEL_PASS / HUE_BASE_URL / HUE_USERNAME /
#   HUE_LIVING_ROOM_GROUP / HUE_SECONDARY_ROOM_GROUP
# See ../.env.example for placeholders. NEVER commit a file with real values.

# ---------------------------------------------------------------------------
# LAB-only credentials (POC + the homelab mock).
# BOTH homelab/mock_zyxel_vuln_6952.py and poc/poc_f_cve_2026_6952_lab.py read
# the SAME two variables, so they always stay in sync at runtime.
# Leave unset to use the demo defaults (admin / LabPass#2026).
#
# The lab PoC deliberately NEVER reads ZYXEL_PASS: the real router password
# must not be sent to the lab mock (and the mock rejects it anyway).
export LAB_USER=""
export LAB_PASS=""
